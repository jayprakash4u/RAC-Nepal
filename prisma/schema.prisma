// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// An admin account. Password is stored as a bcrypt hash, never plaintext.
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @db.VarChar(200)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]

  @@map("admin_users")
}

// A logged-in admin session. The cookie holds `token`; only its bcrypt-free
// SHA-256 hash is stored here so a DB leak alone can't be replayed as a cookie.
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(200)
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@map("admin_sessions")
}

// A request submitted through the site's "Book an Appointment" form.
model AppointmentRequest {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(200)
  phone           String    @db.VarChar(50)
  email           String    @db.VarChar(200)
  appointmentType String    @db.VarChar(50)
  preferredDate   DateTime? @db.Date
  preferredTime   String?   @db.VarChar(50)
  message         String?   @db.VarChar(2000)
  source          String?   @db.VarChar(100)
  status          String    @default("new") @db.VarChar(20) // new | contacted | completed | cancelled
  emailSent       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("appointment_requests")
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String   @db.VarChar(500)
  alt       String   @db.VarChar(300)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("gallery_images")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String   @db.VarChar(2000)
  name      String   @db.VarChar(200)
  role      String   @db.VarChar(200)
  initials  String   @db.VarChar(10)
  imageSrc  String?  @db.VarChar(500)
  imageAlt  String?  @db.VarChar(300)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Video {
  id           String   @id @default(cuid())
  youtubeId    String   @db.VarChar(50)
  title        String   @db.VarChar(300)
  category     String   @db.VarChar(50)
  startSeconds Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("videos")
}

// `sections` holds the article body as JSON (paragraph/heading/list/callout
// blocks) — a JSON column is a better fit here than normalizing each block
// type into its own table for how this content is actually authored and read.
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(200)
  title       String   @db.VarChar(300)
  excerpt     String   @db.VarChar(1000)
  category    String   @db.VarChar(100)
  publishedAt DateTime @db.Date
  readTime    String   @db.VarChar(50)
  imageSrc    String   @db.VarChar(500)
  imageAlt    String   @db.VarChar(300)
  sections    String   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}
